# ФУНКЦИЯ ДЕКОДИРОВАНИЯ BASE64 UTF-32LE
function Decode-Base64UTF32LE {
    param([string]$Base64String)
    $bytes = [System.Convert]::FromBase64String($Base64String)
    $utf32 = [System.Text.Encoding]::UTF32
    return $utf32.GetString($bytes)
}

# ФУНКЦИЯ ИЗВЛЕЧЕНИЯ БЛОКА МУСОРНОГО КОДА ПО НОМЕРУ
function Extract-GarbageBlock {
    param(
        [string]$DictionaryContent,
        [int]$BlockNumber
    )
    $flag = "'#garbage code for substitution: $BlockNumber"
    $startIndex = $DictionaryContent.IndexOf($flag)
    if ($startIndex -eq -1) { return $null }
    $blockStart = $startIndex + $flag.Length
    $nextFlagPattern = "'#garbage code for substitution:"
    $nextFlagIndex = $DictionaryContent.IndexOf($nextFlagPattern, $blockStart)
    if ($nextFlagIndex -eq -1) {
        $blockContent = $DictionaryContent.Substring($blockStart).Trim()
    } else {
        $blockContent = $DictionaryContent.Substring($blockStart, $nextFlagIndex - $blockStart).Trim()
    }
    return $blockContent
}

# ФУНКЦИЯ ВСТАВКИ МУСОРА В MAIN LOGIC
function Insert-GarbageIntoMain {
    param(
        [string]$MainContent,
        [string[]]$GarbageBlocks
    )
    $result = $MainContent
    for ($i = 0; $i -lt 3; $i++) {
        $placeholder = "'#placeholders for garbage code insertion: $($i + 1)"
        $insertIndex = $result.IndexOf($placeholder)
        if ($insertIndex -eq -1) { return $null }
        $lineEnd = $result.IndexOf("`n", $insertIndex)
        if ($lineEnd -eq -1) { $lineEnd = $result.Length }
        $insertPos = $lineEnd + 1
        $garbageWithNewline = "`n" + $GarbageBlocks[$i] + "`n"
        $result = $result.Insert($insertPos, $garbageWithNewline)
    }
    return $result
}

# ФУНКЦИЯ ГЕНЕРАЦИИ УНИКАЛЬНЫХ СЛУЧАЙНЫХ ЧИСЕЛ
function Get-UniqueRandomNumbers {
    param(
        [int]$Count = 3,
        [int]$Min = 1,
        [int]$Max = 22
    )
    $numbers = @()
    while ($numbers.Count -lt $Count) {
        $num = Get-Random -Minimum $Min -Maximum ($Max + 1)
        if ($num -notin $numbers) {
            $numbers += $num
        }
    }
    return $numbers
}

# БАЗОВЫЕ64 СТРОКИ UTF-32LE
$base64MainLogic = ""
$base64Dictionary = ""

# ДЕКОДИРОВАНИЕ СОДЕРЖИМОГО
$mainLogicContent = Decode-Base64UTF32LE -Base64String $base64MainLogic
$dictionaryContent = Decode-Base64UTF32LE -Base64String $base64Dictionary

# ВЫБОР 3 УНИКАЛЬНЫХ БЛОКОВ МУСОРА
$selectedBlocks = Get-UniqueRandomNumbers -Count 3 -Min 1 -Max 22

# ИЗВЛЕЧЕНИЕ ВЫБРАННЫХ БЛОКОВ
$garbageBlocks = @()
foreach ($num in $selectedBlocks) {
    $block = Extract-GarbageBlock -DictionaryContent $dictionaryContent -BlockNumber $num
    if ($null -eq $block) { exit 1 }
    $garbageBlocks += $block
}

# ВСТАВКА МУСОРА В MAIN LOGIC
$finalContent = Insert-GarbageIntoMain -MainContent $mainLogicContent -GarbageBlocks $garbageBlocks
if ($null -eq $finalContent) { exit 1 }

